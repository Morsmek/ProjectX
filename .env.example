# Project Aegis — Environment Configuration
# Copy to .env and fill in values before running

# ─── Secrets (generate with: python scripts/gen-keys.py) ──────────────────
SECRET_KEY=
REDIS_PASSWORD=
POSTGRES_PASSWORD=
BLOCKCHAIN_NODE_KEY=
BLOCKCHAIN_VALIDATOR_KEYS=
HERMES_SIGNING_KEY=
TOKEN_SIGNING_KEY=
KILL_SWITCH_KEY=

# ─── Blockchain ────────────────────────────────────────────────────────────
CHAIN_ID=1337
BLOCK_TIME=5

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=aegis

# ─── Security ──────────────────────────────────────────────────────────────
DIODE_MODE=strict          # strict | permissive
MULTISIG_THRESHOLD=2       # signatures required for authorized reads
ANOMALY_THRESHOLD=0.75     # SDBA trigger score (0.0–1.0)

# ─── VDI ──────────────────────────────────────────────────────────────────
VDI_SESSION_TTL=28800      # 8 hours in seconds

# ─── Mesh ─────────────────────────────────────────────────────────────────
MESH_NODE_ID=node-0

# ─── Module Licenses ───────────────────────────────────────────────────────
MUNNIN_LICENSE_KEY=
PLINXX_LICENSE_KEY=
